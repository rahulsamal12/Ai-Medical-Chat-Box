# Groq API Key for LLM Inference (Required for medibot.py and connect_memory_with_llm.py)
# Get your free API key at https://console.groq.com/keys
GROQ_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# HuggingFace Token (Optional: used only if using HuggingFace Inference API endpoints)
# Get your token at https://huggingface.co/settings/tokens
HF_TOKEN=xxxxxxxxxxxxxxxxxxxxx

# LangChain Tracing (Optional - set to false to suppress unauthenticated tracing warnings)
LANGCHAIN_TRACING_V2=false
